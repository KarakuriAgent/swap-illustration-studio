# Swap Illustration Studio の設定（このファイルを .env に写して編集。.env は git 管理外）

# 待ち受け（ホスト側）。127.0.0.1 ならこの PC からだけ使える。
# スマホから LAN 越しに使うときは 0.0.0.0 などにする（そのときは ACCESS_TOKEN が必須）
HOST=127.0.0.1
PORT=2760

# アクセストークン（HOST が 127.0.0.1 以外のとき必須。16 文字以上。例: openssl rand -hex 24）
#ACCESS_TOKEN=
# 127.0.0.1 で待ち受けていてもトークンを要求したいとき（Tailscale Serve / Cloudflare Tunnel で公開するとき）
#REQUIRE_TOKEN=1

# ローカルの ComfyUI の URL（./run.sh で起動するとき）
COMFY_URL=http://127.0.0.1:8188
# Docker で起動するときの ComfyUI の URL（既定はホストの ComfyUI）
#DOCKER_COMFY_URL=http://host.docker.internal:8188

# ComfyUI の models フォルダ（セットアップでモデル・LoRA をダウンロードする先。任意）
#COMFY_MODELS_DIR=/path/to/ComfyUI/models

# Comfy Cloud の API キー（画面の設定からも入れられる。秘密情報なので git に入れない）
#COMFY_CLOUD_API_KEY=

# Hugging Face のトークン（任意。非公開・同意が必要なリポジトリから落とすときだけ）
#HF_TOKEN=

# LoRA の取得元と SHA-256（既定値で良ければ書かなくてよい）
#LORA_HF_REPO=Kohei-Yamashita/swap-illustration-lora
#LORA_SHA256=0e51ca1e452bce7b8406d1be4808a15cc1feb237c86ed39f70d2e6b1379d63b0

# データの置き場（既定はリポジトリ直下の data/。Docker では ./data がマウントされる）
#SWAP_DATA_DIR=
